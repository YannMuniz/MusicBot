# Copie para .env e troque o token (ex.: openssl rand -hex 32)
ANALYZER_INTERNAL_TOKEN=troque-por-um-segredo-longo
ANALYZER_MAX_UPLOAD_MB=100
ANALYZER_MAX_DURATION_S=900

# Banco e aplicação web (gere o APP_KEY com: echo "base64:$(openssl rand -base64 32)")
DB_PASSWORD=troque-esta-senha
APP_KEY=
APP_DEBUG=false
